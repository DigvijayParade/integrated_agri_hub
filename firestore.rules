rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Check if the user is an admin
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Check if the user is a shopkeeper
    function isShopkeeper() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'shopkeeper';
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    match /farmers/{farmerId} {
      allow read: if isAuth();
      allow update: if request.auth.uid == farmerId || isShopkeeper() || isAdmin();
      allow create, delete: if request.auth.uid == farmerId || isAdmin();
      
      match /transactions/{txId} {
        allow read: if request.auth.uid == farmerId || isAdmin();
        allow create: if request.auth.uid == farmerId || isShopkeeper() || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /notifications/{notifId} {
        allow read: if request.auth.uid == farmerId || isAdmin();
        allow create, write: if isAdmin();
      }
    }

    match /shopkeepers/{shopId} {
      allow read: if isAuth();
      allow write: if request.auth.uid == shopId || isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Admin uploads CSV → writes mandi prices
    // Farmers and Shopkeepers can read
    match /market_prices/{priceId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Shopkeeper sets discounts per product
    match /shopkeeper_inventory/{invId} {
      allow read: if isAuth();
      allow create, update: if isShopkeeper() || isAdmin();
      allow delete: if isAdmin();
    }

    // Farmers submit task proof, Admin approves/rejects
    match /task_submissions/{submissionId} {
      allow read: if isAuth();
      allow create: if isAuth(); // farmer submits
      allow update: if isAdmin(); // admin approves/rejects
      allow delete: if isAdmin();
    }

    // Green Coin purchase transactions (Farmer → Shopkeeper)
    match /green_coin_transactions/{txId} {
      allow read: if isAuth();
      allow create: if isAuth(); // created during purchase
      allow update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
